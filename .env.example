# ==========================================
# L-ENGLISH ACADEMY - ENVIRONMENT VARIABLES
# ==========================================

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Direct PostgreSQL Connection (For pg_dump & NestJS Backend)
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres

# LiveKit SFU WebRTC Voice Configuration (Optional - fallback to WebRTC mesh signaling if not provided)
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_URL=wss://your-project.livekit.cloud
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# Test Accounts (Dev Environment)
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=your-strong-admin-password
TEST_STUDENT_EMAIL=student@example.com
TEST_STUDENT_PASSWORD=your-strong-student-password

# Neon (staging/production DB) — do `npx neon deploy` / `neon env pull` tự ghi vào .env, không sửa tay.
# Backend chạy local KHÔNG đọc các biến này (dùng backend/.env trỏ Postgres docker).
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=br-xxx
