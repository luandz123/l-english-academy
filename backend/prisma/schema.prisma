// Schema baseline: introspect từ DB Supabase production (2026-10-25), làm sạch:
// - Model PascalCase số ít, field camelCase; @map/@@map giữ nguyên tên bảng/cột cũ.
// - auth.users (Supabase) thay bằng bảng users riêng (ADR 0002). Hàm handle_new_user → AuthService.
// - Trigger update_updated_at_column (profiles, user_notes) → @updatedAt.
// - CHECK constraints không biểu diễn được trong Prisma: thêm tay trong migration baseline.
// - vocab_questions.question_id, vocab_quizzes.lesson_id: BigInt → Int (cùng kiểu với khóa được tham chiếu).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

/// Thay cho auth.users của Supabase. Dữ liệu tài khoản cũ không chuyển (DECISIONS D-05).
model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique
  passwordHash    String?   @map("password_hash")
  googleId        String?   @unique @map("google_id")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  /// Tương đương raw_user_meta_data của Supabase: full_name, avatar_url, bio, cover_url…
  /// Frontend đọc qua user.user_metadata (Profile.tsx dùng updateUser({ data })).
  userMetadata    Json      @default("{}") @map("user_metadata")
  lastSignInAt    DateTime? @map("last_sign_in_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  refreshTokens         RefreshToken[]
  authTokens            AuthToken[]
  profile               Profile?
  roles                 UserRole[]
  enrollments           Enrollment[]
  paymentOrders         PaymentOrder[]
  lessonProgress        UserLessonProgress[]
  listeningStepProgress UserListeningStepProgress[]
  notes                 UserNote[]
  favorites             UserFavorite[]
  quizResults           UserQuizResult[]
  fullTestResults       UserFullTestResult[]
  adminActivityLogs     AdminActivityLog[]
  adminNotesWritten     AdminStudentNote[]          @relation("AdminStudentNoteAdmin")
  adminNotesAboutMe     AdminStudentNote[]          @relation("AdminStudentNoteStudent")
  speakingRoomsHosted   SpeakingRoom[]
  speakingMemberships   SpeakingRoomMember[]
  speakingSessions      SpeakingSession[]
  roadmap               UserRoadmap?
  roadmapWeekPlans      RoadmapWeekPlan[]
  recommendationSkips   ExamRecommendationSkip[]
  practiceSessions      PracticeSession[]
  mistakeItems          MistakeNotebookItem[]
  favoriteExams         FavoriteExam[]
  examReports           ExamReport[]

  @@map("users")
}

/// Refresh token xoay vòng (ADR 0002). Chỉ lưu SHA-256 của token.
/// Mỗi lần đăng nhập mở một family; token đã dùng mà bị dùng lại → thu hồi cả family.
model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

enum AuthTokenType {
  email_verification
  password_recovery

  @@map("auth_token_type")
}

/// Token một lần trong link email (xác nhận đăng ký, đặt lại mật khẩu). Chỉ lưu SHA-256.
model AuthToken {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model AdminActivityLog {
  id         Int       @id @default(autoincrement())
  adminId    String?   @map("admin_id") @db.Uuid
  action     String
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id")
  details    Json?
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  admin      User?     @relation(fields: [adminId], references: [id], onUpdate: NoAction)

  @@map("admin_activity_log")
}

model AdminStudentNote {
  id        Int       @id @default(autoincrement())
  adminId   String    @map("admin_id") @db.Uuid
  studentId String    @map("student_id") @db.Uuid
  content   String
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  admin     User      @relation("AdminStudentNoteAdmin", fields: [adminId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student   User      @relation("AdminStudentNoteStudent", fields: [studentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("admin_student_notes")
}

model Answer {
  id                    Int                    @id @default(autoincrement())
  questionId            Int?                   @map("question_id")
  answerText            String?                @map("answer_text")
  isCorrect             Boolean?               @default(false) @map("is_correct")
  explanation           String?
  displayOrder          Int                    @default(0) @map("display_order")
  question              Question?              @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fullTestAnswerDetails FullTestAnswerDetail[]
  userAnswers           UserAnswer[]

  @@index([questionId], map: "idx_answers_question_id")
  @@map("answers")
}

model CourseCategory {
  id           BigInt    @id @default(autoincrement())
  name         String
  slug         String    @unique
  icon         String?
  displayOrder Int?      @default(0) @map("display_order")
  isActive     Boolean?  @default(true) @map("is_active")
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  courses      Course[]

  @@map("course_categories")
}

model Course {
  id              Int             @id @default(autoincrement())
  title           String
  subtitle        String?
  description     String?
  courseType      String          @map("course_type")
  price           Int?            @default(0)
  durationMonths  Int?            @default(6) @map("duration_months")
  thumbnailUrl    String?         @map("thumbnail_url")
  instructor      String?         @default("Cô Mai Phương")
  isActive        Boolean?        @default(true) @map("is_active")
  displayOrder    Int?            @default(0) @map("display_order")
  createdAt       DateTime?       @default(now()) @map("created_at") @db.Timestamptz(6)
  isFree          Boolean?        @default(false) @map("is_free")
  categoryId      BigInt?         @map("category_id")
  courseCategory  CourseCategory? @relation(fields: [categoryId], references: [id], onUpdate: NoAction)
  enrollments     Enrollment[]
  fullTests       FullTest[]
  materials       Material[]
  modules         Module[]
  vocabCategories VocabCategory[]

  @@map("courses")
}

model Enrollment {
  id         Int       @id @default(autoincrement())
  userId     String    @map("user_id") @db.Uuid
  courseId   Int       @map("course_id")
  enrolledAt DateTime? @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, courseId])
  @@index([userId, courseId], map: "idx_enrollments_user_course")
  @@map("enrollments")
}

model FullTestAnswerDetail {
  id                 Int                @id @default(autoincrement())
  resultId           Int                @map("result_id")
  questionId         Int                @map("question_id")
  selectedAnswerId   Int?               @map("selected_answer_id")
  isCorrect          Boolean?           @default(false) @map("is_correct")
  partNumber         Int?               @map("part_number")
  question           Question           @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  userFullTestResult UserFullTestResult @relation(fields: [resultId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  answer             Answer?            @relation(fields: [selectedAnswerId], references: [id], onUpdate: NoAction)

  @@map("full_test_answer_details")
}

model FullTestSection {
  id         Int       @id @default(autoincrement())
  testId     Int?      @map("test_id")
  partNumber Int       @map("part_number")
  quizId     Int?      @map("quiz_id")
  quiz       Quiz?     @relation(fields: [quizId], references: [id], onUpdate: NoAction)
  fullTest   FullTest? @relation(fields: [testId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("full_test_sections")
}

model FullTest {
  id                  Int                  @id @default(autoincrement())
  courseId            Int?                 @map("course_id")
  category            String               @default("general")
  title               String
  totalQuestions      Int?                 @default(200) @map("total_questions")
  releaseDate         DateTime?            @map("release_date") @db.Timestamptz(6)
  displayOrder        Int                  @default(0) @map("display_order")
  createdAt           DateTime?            @default(now()) @map("created_at") @db.Timestamptz(6)
  audioUrl            String?              @map("audio_url")
  description         String?
  totalAttempts       Int?                 @default(10) @map("total_attempts")
  /// Thông tin thư viện đề (module practice). year null → lấy từ tiêu đề.
  year                  Int?
  difficulty            String?
  topics                String[]             @default([])
  testType              String               @default("full") @map("test_type")
  durationMinutes       Int?                 @map("duration_minutes")
  /// 'unverified' | 'verified' | 'needs_review' (trigger đổi sang needs_review khi sửa nội dung)
  verificationStatus    String               @default("unverified") @map("verification_status")
  verificationChecklist Json?                @map("verification_checklist")
  verifiedAt            DateTime?            @map("verified_at") @db.Timestamptz(6)
  verifiedBy            String?              @map("verified_by") @db.Uuid
  contentChangedAt      DateTime?            @map("content_changed_at") @db.Timestamptz(6)
  fullTestSections    FullTestSection[]
  course              Course?              @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  userFullTestResults UserFullTestResult[]

  @@map("full_tests")
}

model LessonPractice {
  id               Int       @id @default(autoincrement())
  lessonId         Int       @map("lesson_id")
  quizId           Int?      @map("quiz_id")
  triggerAtSeconds Int       @default(0) @map("trigger_at_seconds")
  title            String?   @default("")
  displayOrder     Int       @default(0) @map("display_order")
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  lesson           Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  quiz             Quiz?     @relation(fields: [quizId], references: [id], onUpdate: NoAction)

  @@map("lesson_practices")
}

model Lesson {
  id                 Int                  @id @default(autoincrement())
  moduleId           Int?                 @map("module_id")
  title              String
  videoUrl           String?              @map("video_url")
  durationSeconds    Int?                 @default(0) @map("duration_seconds")
  displayOrder       Int                  @default(0) @map("display_order")
  isLive             Boolean?             @default(false) @map("is_live")
  liveTime           DateTime?            @map("live_time") @db.Timestamptz(6)
  lessonType         String               @default("video") @map("lesson_type")
  quizId             Int?                 @map("quiz_id")
  pdfUrl             String?              @map("pdf_url")
  isFree             Boolean?             @default(false) @map("is_free")
  isPublished        Boolean              @default(true) @map("is_published")
  lessonPractices    LessonPractice[]
  module             Module?              @relation(fields: [moduleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  quiz               Quiz?                @relation(fields: [quizId], references: [id], onUpdate: NoAction)
  materials          Material[]
  userFavorites      UserFavorite[]
  userLessonProgress UserLessonProgress[]
  userNotes          UserNote[]
  vocabQuizzes       VocabQuiz[]

  @@index([quizId], map: "idx_lessons_quiz_id")
  @@map("lessons")
}

model Material {
  id           Int       @id @default(autoincrement())
  lessonId     Int?      @map("lesson_id")
  quizId       Int?      @map("quiz_id")
  courseId     Int?      @map("course_id")
  title        String
  fileUrl      String    @map("file_url")
  fileType     String?   @default("pdf") @map("file_type")
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  folderPath   String?   @default("/") @map("folder_path")
  course       Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lesson       Lesson?   @relation(fields: [lessonId], references: [id], onUpdate: NoAction)
  quiz         Quiz?     @relation(fields: [quizId], references: [id], onUpdate: NoAction)

  @@index([folderPath], map: "idx_materials_folder_path")
  @@map("materials")
}

model Module {
  id           Int      @id @default(autoincrement())
  courseId     Int?     @map("course_id")
  title        String
  description  String?
  displayOrder Int      @default(0) @map("display_order")
  isFree       Boolean? @default(false) @map("is_free")
  isPublished  Boolean  @default(true) @map("is_published")
  lessons      Lesson[]
  course       Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  quizzes      Quiz[]

  @@map("modules")
}

model PaymentOrder {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderCode          String    @unique @map("order_code")
  userId             String    @map("user_id") @db.Uuid
  amount             Decimal   @db.Decimal
  planType           String?   @default("vip_combo") @map("plan_type")
  status             String?   @default("pending")
  paymentGateway     String?   @default("vietqr_sepay") @map("payment_gateway")
  bankTransactionId  String?   @map("bank_transaction_id")
  transactionContent String?   @map("transaction_content")
  paidAt             DateTime? @map("paid_at") @db.Timestamptz(6)
  metadata           Json?     @default("{}")
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([orderCode], map: "idx_payment_orders_order_code")
  @@index([status], map: "idx_payment_orders_status")
  @@index([userId], map: "idx_payment_orders_user_id")
  @@map("payment_orders")
}

model PlatformSetting {
  key       String    @id
  value     String
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("platform_settings")
}

model Profile {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String    @unique @map("user_id") @db.Uuid
  fullName             String?   @map("full_name")
  avatarUrl            String?   @map("avatar_url")
  createdAt            DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  email                String?
  isPro                Boolean?  @default(false) @map("is_pro")
  proPlan              String?   @default("free") @map("pro_plan")
  proActivatedAt       DateTime? @map("pro_activated_at") @db.Timestamptz(6)
  /// Phòng luyện nói: trình độ tự chọn và tổng thời gian đã nói (migration Supabase 20261023_speaking_rooms)
  englishLevel         String?   @default("B1") @map("english_level")
  totalSpeakingSeconds Int?      @default(0) @map("total_speaking_seconds")
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("profiles")
}

model Question {
  id                    Int                    @id @default(autoincrement())
  quizId                Int?                   @map("quiz_id")
  questionText          String?                @map("question_text")
  questionType          String?                @default("multiple_choice") @map("question_type")
  imageUrl              String?                @map("image_url")
  audioUrl              String?                @map("audio_url")
  displayOrder          Int                    @default(0) @map("display_order")
  translation           String?
  dictationKeywords     String?                @map("dictation_keywords")
  explanation           String?
  transcript            String?
  knowledgeTag          String?                @map("knowledge_tag")
  passageText           String?                @map("passage_text")
  groupId               String?                @map("group_id")
  answers               Answer[]
  fullTestAnswerDetails FullTestAnswerDetail[]
  quiz                  Quiz?                  @relation(fields: [quizId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  userAnswers           UserAnswer[]
  vocabQuestions        VocabQuestion[]
  /// Nhãn luyện tập (module practice). Bộ gắn nhãn tự động điền; admin sửa thì tag_source = 'admin'.
  toeicPart             Int?                   @map("toeic_part") @db.SmallInt
  sourceTestId          Int?                   @map("source_test_id")
  groupKey              String?                @map("group_key")
  partIndex             Int?                   @map("part_index")
  questionCategory      String?                @map("question_category")
  passageType           String?                @map("passage_type")
  difficulty            String?
  tagSource             String?                @map("tag_source")
  practiceEligible      Boolean                @default(false) @map("practice_eligible")
  taggedAt              DateTime?              @map("tagged_at") @db.Timestamptz(6)
  practiceAnswers       PracticeAnswer[]
  mistakeItems          MistakeNotebookItem[]

  @@index([quizId], map: "idx_questions_quiz_id")
  @@index([toeicPart, practiceEligible, questionCategory], map: "idx_questions_practice")
  @@index([sourceTestId], map: "idx_questions_source_test")
  @@index([groupKey], map: "idx_questions_group_key")
  @@map("questions")
}

model Quiz {
  id               Int               @id @default(autoincrement())
  moduleId         Int?              @map("module_id")
  title            String
  totalQuestions   Int               @default(0) @map("total_questions")
  timeLimitSeconds Int?              @default(0) @map("time_limit_seconds")
  displayOrder     Int               @default(0) @map("display_order")
  audioUrl         String?           @map("audio_url")
  isFree           Boolean?          @default(false) @map("is_free")
  fullTestSections FullTestSection[]
  lessonPractices  LessonPractice[]
  lessons          Lesson[]
  materials        Material[]
  questions        Question[]
  module           Module?           @relation(fields: [moduleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  userQuizResults  UserQuizResult[]

  @@map("quizzes")
}

model UserAnswer {
  id               Int            @id @default(autoincrement())
  resultId         Int            @map("result_id")
  questionId       Int            @map("question_id")
  selectedAnswerId Int?           @map("selected_answer_id")
  isCorrect        Boolean?       @map("is_correct")
  question         Question       @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  userQuizResult   UserQuizResult @relation(fields: [resultId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  answer           Answer?        @relation(fields: [selectedAnswerId], references: [id], onUpdate: NoAction)

  @@index([questionId], map: "idx_user_answers_question_id")
  @@index([resultId], map: "idx_user_answers_result_id")
  @@map("user_answers")
}

model UserFavorite {
  id        Int       @id @default(autoincrement())
  userId    String    @map("user_id") @db.Uuid
  lessonId  Int       @map("lesson_id")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  lesson    Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, lessonId])
  @@map("user_favorites")
}

model UserFullTestResult {
  id                    Int                    @id @default(autoincrement())
  userId                String                 @map("user_id") @db.Uuid
  testId                Int                    @map("test_id")
  totalScore            Int?                   @map("total_score")
  listeningScore        Int?                   @map("listening_score")
  readingScore          Int?                   @map("reading_score")
  correctAnswers        Int?                   @map("correct_answers")
  timeSpentSeconds      Int?                   @map("time_spent_seconds")
  completedAt           DateTime?              @default(now()) @map("completed_at") @db.Timestamptz(6)
  totalQuestions        Int?                   @default(200) @map("total_questions")
  listeningCorrect      Int?                   @default(0) @map("listening_correct")
  readingCorrect        Int?                   @default(0) @map("reading_correct")
  pauseCount            Int?                   @default(0) @map("pause_count")
  testMode              String?                @default("exam") @map("test_mode")
  answersDetail         Json?                  @map("answers_detail")
  fullTestAnswerDetails FullTestAnswerDetail[]
  fullTest              FullTest               @relation(fields: [testId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_full_test_results")
}

model UserLessonProgress {
  id                   Int       @id @default(autoincrement())
  userId               String    @map("user_id") @db.Uuid
  lessonId             Int       @map("lesson_id")
  isCompleted          Boolean?  @default(false) @map("is_completed")
  lastWatchedAt        DateTime? @default(now()) @map("last_watched_at") @db.Timestamptz(6)
  watchDurationSeconds Int?      @default(0) @map("watch_duration_seconds")
  lesson               Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, lessonId])
  @@map("user_lesson_progress")
}

/// Tiến độ "Luyện nghe từng bước" (7 bước) theo từng bài; bài luyện là dữ liệu tĩnh ở frontend nên chỉ lưu mã bài
model UserListeningStepProgress {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  clusterId      String    @map("cluster_id")
  completedSteps Int[]     @default([]) @map("completed_steps")
  currentStep    Int       @default(1) @map("current_step")
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, clusterId])
  @@map("user_listening_step_progress")
}

model UserNote {
  id        Int       @id @default(autoincrement())
  userId    String    @map("user_id") @db.Uuid
  lessonId  Int       @map("lesson_id")
  content   String
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  lesson    Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_notes")
}

model UserQuizResult {
  id               Int          @id @default(autoincrement())
  userId           String       @map("user_id") @db.Uuid
  quizId           Int          @map("quiz_id")
  score            Decimal?     @db.Decimal(5, 2)
  correctAnswers   Int?         @map("correct_answers")
  totalQuestions   Int?         @map("total_questions")
  timeSpentSeconds Int?         @map("time_spent_seconds")
  completedAt      DateTime?    @default(now()) @map("completed_at") @db.Timestamptz(6)
  userAnswers      UserAnswer[]
  quiz             Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([completedAt(sort: Desc)], map: "idx_user_quiz_results_completed")
  @@index([userId, quizId], map: "idx_user_quiz_results_user_quiz")
  @@map("user_quiz_results")
}

model UserRole {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String  @map("user_id") @db.Uuid
  role   AppRole @default(student)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, role])
  @@map("user_roles")
}

model VocabCategory {
  id           Int         @id @default(autoincrement())
  courseId     Int?        @map("course_id")
  title        String
  displayOrder Int         @default(0) @map("display_order")
  course       Course?     @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vocabQuizzes VocabQuiz[]

  @@map("vocab_categories")
}

model VocabQuestion {
  id              Int        @id @default(autoincrement())
  vocabQuizId     Int?       @map("vocab_quiz_id")
  word            String
  phonetic        String?
  definitionEn    String?    @map("definition_en")
  definitionVi    String?    @map("definition_vi")
  exampleSentence String?    @map("example_sentence")
  imageUrl        String?    @map("image_url")
  audioMaleUrl    String?    @map("audio_male_url")
  audioFemaleUrl  String?    @map("audio_female_url")
  wrongAnswer1    String?    @map("wrong_answer_1")
  wrongAnswer2    String?    @map("wrong_answer_2")
  wrongAnswer3    String?    @map("wrong_answer_3")
  displayOrder    Int        @default(0) @map("display_order")
  questionId      Int?       @map("question_id")
  question        Question?  @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vocabQuiz       VocabQuiz? @relation(fields: [vocabQuizId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([questionId], map: "idx_vocab_questions_question")
  @@index([vocabQuizId], map: "idx_vocab_questions_quiz")
  @@map("vocab_questions")
}

model VocabQuiz {
  id             Int             @id @default(autoincrement())
  categoryId     Int?            @map("category_id")
  title          String
  totalQuestions Int             @default(0) @map("total_questions")
  displayOrder   Int             @default(0) @map("display_order")
  lessonId       Int?            @map("lesson_id")
  vocabQuestions VocabQuestion[]
  vocabCategory  VocabCategory?  @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lesson         Lesson?         @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("vocab_quizzes")
}

enum AppRole {
  admin
  student

  @@map("app_role")
}

/// Phòng luyện nói (thiết kế theo supabase/migrations/20261023_speaking_rooms.sql, chưa từng có trên production — OPEN_QUESTIONS #11).
/// RLS cũ được thay bằng kiểm tra ở SpeakingService.
model SpeakingRoom {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  hostUserId   String               @map("host_user_id") @db.Uuid
  englishLevel String               @map("english_level")
  topics       String[]             @default([])
  visibility   String               @default("public")
  passcode     String?
  capacity     Int                  @default(4)
  status       String               @default("active")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime             @map("expires_at") @db.Timestamptz(6)
  host         User                 @relation(fields: [hostUserId], references: [id], onDelete: Cascade)
  members      SpeakingRoomMember[]
  sessions     SpeakingSession[]

  @@index([status, visibility], map: "idx_speaking_rooms_status_visibility")
  @@index([englishLevel], map: "idx_speaking_rooms_level")
  @@index([hostUserId], map: "idx_speaking_rooms_host")
  @@map("speaking_rooms")
}

model SpeakingRoomMember {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId     String       @map("room_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  role       String       @default("member")
  joinedAt   DateTime     @default(now()) @map("joined_at") @db.Timestamptz(6)
  lastSeenAt DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  isMuted    Boolean      @default(false) @map("is_muted")
  isSpeaking Boolean      @default(false) @map("is_speaking")
  room       SpeakingRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId], map: "uq_speaking_room_user")
  @@index([roomId], map: "idx_speaking_room_members_room")
  @@index([userId], map: "idx_speaking_room_members_user")
  @@map("speaking_room_members")
}

model SpeakingSession {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  roomId          String?       @map("room_id") @db.Uuid
  startedAt       DateTime      @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt         DateTime?     @map("ended_at") @db.Timestamptz(6)
  durationSeconds Int           @default(0) @map("duration_seconds")
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  room            SpeakingRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([userId], map: "idx_speaking_sessions_user")
  @@map("speaking_sessions")
}

/// Lộ trình học cá nhân (mỗi học viên một lộ trình đang dùng). Chỉ lưu đầu vào wizard;
/// tổng giờ, các chặng và tài nguyên được tính lại ở server mỗi lần đọc (roadmap-planner.ts).
model UserRoadmap {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  /// 'score' (tự khai điểm) | 'none' (chưa thi/mất gốc) | 'placement' (bài test nhanh)
  currentMode       String   @map("current_mode")
  /// Điểm xuất phát đã chốt ở server (mất gốc → mốc cố định, placement → ước lượng từ kết quả)
  currentScore      Int      @map("current_score")
  placementResultId Int?     @map("placement_result_id")
  targetScore       Int      @map("target_score")
  purpose           String
  examDate          DateTime? @map("exam_date") @db.Date
  durationWeeks     Int      @map("duration_weeks")
  minutesPerDay     Int      @map("minutes_per_day")
  daysPerWeek       Int      @map("days_per_week")
  startedAt         DateTime @map("started_at") @db.Date
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_roadmaps")
}

/// Một lượt luyện: theo dạng câu, Mini Test, Daily Challenge, luyện câu sai, luyện lại câu sai.
model PracticeSession {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  /// 'question_type' | 'mini_test' | 'daily' | 'mistakes' | 'retry'
  kind             String
  /// 'listening' | 'reading' | 'mixed'
  skill            String
  /// 'practice' | 'test'
  mode             String
  /// 'immediate' | 'end' (chỉ có nghĩa ở chế độ practice)
  feedback         String           @default("end")
  config           Json             @default("{}")
  questionIds      Int[]            @map("question_ids")
  /// 'in_progress' | 'submitted' | 'abandoned'
  status           String           @default("in_progress")
  timeLimitSeconds Int?             @map("time_limit_seconds")
  dailyDate        DateTime?        @map("daily_date") @db.Date
  startedAt        DateTime         @default(now()) @map("started_at") @db.Timestamptz(6)
  submittedAt      DateTime?        @map("submitted_at") @db.Timestamptz(6)
  timeSpentSeconds Int?             @map("time_spent_seconds")
  totalQuestions   Int              @map("total_questions")
  correctCount     Int?             @map("correct_count")
  wrongCount       Int?             @map("wrong_count")
  unansweredCount  Int?             @map("unanswered_count")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  answers          PracticeAnswer[]

  @@index([userId, status], map: "idx_practice_sessions_user_status")
  @@index([userId, kind, dailyDate], map: "idx_practice_sessions_daily")
  @@map("practice_sessions")
}

model PracticeAnswer {
  id               Int             @id @default(autoincrement())
  sessionId        String          @map("session_id") @db.Uuid
  questionId       Int             @map("question_id")
  selectedAnswerId Int?            @map("selected_answer_id")
  isCorrect        Boolean?        @map("is_correct")
  /// Chế độ phản hồi ngay: câu đã chốt, không đổi được nữa
  locked           Boolean         @default(false)
  answeredAt       DateTime        @default(now()) @map("answered_at") @db.Timestamptz(6)
  /// Thời gian làm câu (giây), server ước tính từ mốc lưu đáp án trước đó trong lượt (P11 "Làm chậm")
  timeSeconds      Int?            @map("time_seconds")
  session          PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  question         Question        @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([sessionId, questionId])
  @@map("practice_answers")
}

/// Sổ câu sai: mỗi (học viên, câu hỏi) đúng một dòng. Lịch sử từng lần trả lời ở mistake_attempts.
model MistakeNotebookItem {
  id                   Int              @id @default(autoincrement())
  userId               String           @map("user_id") @db.Uuid
  questionId           Int              @map("question_id")
  wrongCount           Int              @default(0) @map("wrong_count")
  firstWrongAt         DateTime?        @map("first_wrong_at") @db.Timestamptz(6)
  lastWrongAt          DateTime?        @map("last_wrong_at") @db.Timestamptz(6)
  lastSelectedAnswerId Int?             @map("last_selected_answer_id")
  /// 'not_reviewed' | 'improving' | 'fixed'
  status               String           @default("not_reviewed")
  reviewCount          Int              @default(0) @map("review_count")
  lastReviewedAt       DateTime?        @map("last_reviewed_at") @db.Timestamptz(6)
  isBookmarked         Boolean          @default(false) @map("is_bookmarked")
  bookmarkedAt         DateTime?        @map("bookmarked_at") @db.Timestamptz(6)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  question             Question         @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  attempts             MistakeAttempt[]

  @@unique([userId, questionId])
  @@index([userId, status], map: "idx_mistake_items_user_status")
  @@map("mistake_notebook_items")
}

model MistakeAttempt {
  id               Int                 @id @default(autoincrement())
  itemId           Int                 @map("item_id")
  selectedAnswerId Int?                @map("selected_answer_id")
  isCorrect        Boolean             @map("is_correct")
  /// 'full_test' | 'practice'
  source           String
  sourceId         String?             @map("source_id")
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  item             MistakeNotebookItem @relation(fields: [itemId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([itemId], map: "idx_mistake_attempts_item")
  @@map("mistake_attempts")
}

/// Đề yêu thích. Không có FK tới full_tests: đề bị xóa vẫn giữ dòng để báo "không còn khả dụng".
model FavoriteExam {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id") @db.Uuid
  testId     Int      @map("test_id")
  titleCache String   @map("title_cache")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, testId])
  @@map("favorite_exams")
}

/// Học viên báo lỗi đề / câu hỏi; admin xử lý.
model ExamReport {
  id         Int       @id @default(autoincrement())
  userId     String    @map("user_id") @db.Uuid
  testId     Int?      @map("test_id")
  questionId Int?      @map("question_id")
  reason     String
  message    String?
  /// 'open' | 'resolved' | 'dismissed'
  status     String    @default("open")
  adminNote  String?   @map("admin_note")
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status, createdAt], map: "idx_exam_reports_status")
  @@map("exam_reports")
}

/// "Việc tuần này" của lộ trình (P03): chốt một lần đầu tuần (thứ Hai giờ VN) để trọng tâm đổi giữa tuần không làm mất việc đang làm dở.
model RoadmapWeekPlan {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.Uuid
  weekStart DateTime @map("week_start") @db.Date
  /// Danh sách key "part:category" trọng tâm lúc lập kế hoạch
  focus     Json     @default("[]")
  tasks     Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, weekStart])
  @@map("roadmap_week_plans")
}

/// Đề học viên bấm "Không phải lúc này" (E10): không đề xuất lại tới skipped_until.
model ExamRecommendationSkip {
  id           Int      @id @default(autoincrement())
  userId       String   @map("user_id") @db.Uuid
  testId       Int      @map("test_id")
  skippedUntil DateTime @map("skipped_until") @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, testId])
  @@map("exam_recommendation_skips")
}
