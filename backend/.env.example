# Sao chép thành backend/.env khi chạy local. Không commit file .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# App dùng DATABASE_URL.
# - Dev: Postgres 18 trong docker-compose (cổng host 5433)
# - Staging/production (Neon): chuỗi pooled (host có "-pooler"), nên dùng sslmode=verify-full
DATABASE_URL=postgresql://lenglish:lenglish@localhost:5433/lenglish

# Chỉ Prisma CLI (migrate deploy/status) dùng. Bỏ trống thì dùng DATABASE_URL.
# Neon: chuỗi direct (không có "-pooler") vì migrate cần advisory lock.
# DATABASE_URL_UNPOOLED=

# Origin của frontend, cách nhau bởi dấu phẩy
CORS_ORIGINS=http://localhost:8082

# --- Auth (ADR 0002) ---
# Origin công khai của frontend: link trong email + đích redirect. Production phải là https://
FRONTEND_URL=http://localhost:8082
# Tối thiểu 32 ký tự. Tạo: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# DECISIONS C-04: bắt xác nhận email trước khi đăng nhập
AUTH_REQUIRE_EMAIL_CONFIRMATION=true
# Bỏ trống → /auth/google trả 503. Redirect URI trên Google Console: <FRONTEND_URL>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Số proxy phía trước (production: Vercel rewrite + Render = 2)
TRUST_PROXY_HOPS=0

# --- Mail: dev dùng Mailpit (docker-compose), xem thư tại http://localhost:8025 ---
# Production (Gmail): SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true SMTP_USER=<gmail> SMTP_PASS=<App Password>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=L-English Academy <no-reply@lenglish.local>

# smtp (mặc định, dùng Mailpit khi dev) | gmail_api (Render free chặn SMTP → gửi qua HTTPS)
MAIL_PROVIDER=smtp
# Chỉ cần khi MAIL_PROVIDER=gmail_api — cách lấy: docs/STAGING.md §2.5
# MAIL_FROM phải là đúng địa chỉ Gmail đã cấp quyền, ví dụ: L-English Academy <ban@gmail.com>
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Payments (SePay) ---
# Key cấu hình ở SePay > Webhooks > "API Key"; webhook từ chối mọi request nếu để trống
SEPAY_WEBHOOK_API_KEY=
# true chỉ ở staging/dev: nút giả lập thanh toán hoàn tất đơn của chính mình
PAYMENT_SIMULATION_ENABLED=false
